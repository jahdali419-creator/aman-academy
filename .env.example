# ---- Core ----
# Public base URL (used in emails, QR codes and certificate verification links)
APP_URL=http://localhost:3000

# Long random secret for Better Auth. REQUIRED in production: `openssl rand -base64 32`
BETTER_AUTH_SECRET=

# PostgreSQL connection string. Leave empty to use the embedded demo database (.data/pglite).
DATABASE_URL=

# ---- Demo ----
# "true" seeds fictional data and enables one-click demo sign-in. MUST be "false" in production.
DEMO_MODE=true

# ---- Payments ----
# "demo" is the only built-in provider. Connect a real provider before taking payments.
PAYMENT_PROVIDER=demo
# Shared secret used to verify payment webhook signatures (HMAC-SHA256).
PAYMENT_WEBHOOK_SECRET=

# ---- Tax ----
VAT_ENABLED=true
# Basis points: 1500 = 15%
VAT_RATE_BPS=1500
SELLER_VAT_NUMBER=

# ---- Email ----
# "outbox" stores messages in the database (viewable by admins). Connect a provider for production.
EMAIL_PROVIDER=outbox
EMAIL_FROM="Aman Academy <no-reply@example.com>"
